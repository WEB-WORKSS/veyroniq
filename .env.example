# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.
# Only VITE_* values are exposed to the browser. Never put secrets (AWS secret keys, API secrets) in VITE_* variables.

# --- Authentication (Amazon Cognito user pool) -------------------------------
# Leave empty to run in integration-ready mode: sign-in/sign-up screens render,
# but no accounts are created and /dashboard runs as a local sample workspace.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Cognito group for administrators (reserved for future admin features).
VITE_ADMIN_GROUP=admin

# --- Workspace API (API Gateway + Lambda + DynamoDB) -------------------------
# Base URL of the workspace API. Requests send the Cognito ID token as a Bearer token.
# Leave empty to store workspace records in the browser (sample workspace only).
VITE_API_URL=

# --- Lead / contact form ------------------------------------------------------
# HTTPS endpoint that accepts POSTed JSON (e.g. a Lambda function URL, Formspree, Basin).
# Leave empty and the form opens a pre-filled email to the business address instead.
VITE_LEAD_ENDPOINT=

